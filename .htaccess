# Ensure correct MIME types
AddType application/javascript .js
AddType application/javascript .mjs
AddType application/manifest+json .webmanifest
AddType text/css .css

# Enable directory access for apps
<Directory "apps">
   Options Indexes FollowSymLinks
   AllowOverride None
   Require all granted
</Directory>

<IfModule mod_rewrite.c>
   RewriteEngine On
   RewriteBase /
   
   # 1. If the file exists, serve it directly and stop
   RewriteCond %{REQUEST_FILENAME} -f
   RewriteRule ^ - [L]

   # 2. Redirect directories without trailing slash
   RewriteCond %{REQUEST_FILENAME} -d
   RewriteCond %{REQUEST_URI} !/$
   RewriteRule ^(.*)$ $1/ [L]

   # 3. SPA Routing: Redirect everything else to index.html
   RewriteRule ^index\.html$ - [L]
   RewriteCond %{REQUEST_FILENAME} !-f
   RewriteCond %{REQUEST_FILENAME} !-d
   RewriteRule . /index.html [L]
</IfModule>

# Prevent caching of the environment config
<Files "env.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </IfModule>
</Files>

# Fix for module loading issues
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|css|webmanifest)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>
